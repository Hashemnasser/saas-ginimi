# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# استثناء ملف .env.example ليبقى في المستودع كقالب
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma (ملفات قاعدة البيانات المحلية والمولدات)
/src/generated/prisma
prisma/*.db
prisma/*.sqlite
prisma/*.sqlite-journal

# keploy (مجلد اختبارات Keploy)
/keploy/

# sentry (إضافي)
.env.sentry-build-plugin
.sentryclirc

# ملفات مؤقتة أو مخبأة
*.log
.cache/
.turbo/